# Salin file ini ke .env dan .env.local
DATABASE_URL="file:../data/library.db"
SESSION_SECRET="ganti-dengan-secret-random-minimal-32-karakter"

# Mode Simulasi OTP Reset Password (aktif di development bila SMTP belum diisi)
OTP_SIMULATION="true"

# Opsional: Konfigurasi SMTP untuk pengiriman email OTP sungguhan
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@charvlibrary.ac.id"
# SMTP_PASS="password-smtp"
